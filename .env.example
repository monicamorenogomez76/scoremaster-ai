# Development examples only; replace before deployment. Never commit .env.
POSTGRES_DB=scoremaster
POSTGRES_USER=scoremaster
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
# Host Python development (Docker API uses the internal hostname db):
DATABASE_URL=postgresql+psycopg://scoremaster:change-me-local-only@127.0.0.1:5433/scoremaster
# Demo user created at start-up (test credentials, see README). Change them outside a local demo.
DEMO_USER_EMAIL=demo@scoremaster.local
DEMO_USER_PASSWORD=scoremaster-demo
# The demo account starts with works, a band, a concert and a campaign (0 to start empty).
DEMO_SEED_CONTENT=1
# Accounts that manage evaluation campaigns and see the musicians' emails and results (comma-separated).
# In production the account must have confirmed its email (the link it gets on registering). Never the demo account.
ADMIN_EMAILS=
# Optional Google sign-in (disabled while either value is empty).
# Redirect URI to register in Google Cloud: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional password recovery by email with Brevo (https://www.brevo.com, free plan). Without them, in development
# the link is written to the server's log; in production there is no recovery. APP_BASE_URL is the address in the link.
BREVO_API_KEY=
MAIL_FROM=
APP_BASE_URL=
# production: Secure cookies and no interactive API docs (requires HTTPS).
APP_ENV=development

# Explanations with Google Gemini (step 21, optional). Key from https://aistudio.google.com/apikey;
# without it the app uses the demo, always identified as «Modo demo · sin IA».
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Method B (Valorar con IA) may use its own model, e.g. gemini-3.5-flash-lite (more free quota).
# GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite
# GEMINI_REQUESTS_PER_MINUTE=5
# Prices of a paid plan, in dollars per million tokens, for the estimated cost of Configuración › Uso de la IA.
# GEMINI_PRICE_INPUT_PER_MTOK=
# GEMINI_PRICE_OUTPUT_PER_MTOK=
